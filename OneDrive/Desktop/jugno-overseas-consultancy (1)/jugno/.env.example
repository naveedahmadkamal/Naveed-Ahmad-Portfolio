# Copy this file to .env for local development and fill in real values.
# Never commit your actual .env file.

# Flask secret key (used for session signing). Generate a random string for production.
SECRET_KEY=change-this-to-a-long-random-string

# Optional: set a key to protect the /api/applications admin endpoint.
# Leave unset to keep that endpoint disabled (it returns 401 without a matching key).
ADMIN_KEY=change-this-to-a-long-random-string

# Database URL. Leave unset to use local SQLite at instance/jugno.db.
# On Render, attach a PostgreSQL database and Render will provide this value.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" to enable Flask debug mode locally. Never enable in production.
FLASK_DEBUG=false

# Port the app listens on locally (Render sets this automatically in production).
PORT=5000
